{
  "name": "@sonora/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:recommendations": "tsx --test src/recommendation-core.test.ts",
    "test:import": "tsx --test src/import-core.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^11.2.2",
    "@supabase/supabase-js": "2.119.0",
    "@types/node": "^22.10.5",
    "fastify": "^5.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
