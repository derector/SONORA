<?xml version="1.0" encoding="utf-8"?>
<!--
  Files SONORA may hand to another app. Only the downloaded update APK is shareable:
  the app-private cache directory stays private, so a stale track download can never be
  exposed by accident. The name is an identifier; the path is the file inside cacheDir.
-->
<paths>
    <cache-path
        name="ota_apk"
        path="sonora-update.apk" />
</paths>
