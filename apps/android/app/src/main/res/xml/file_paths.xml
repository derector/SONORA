<?xml version="1.0" encoding="utf-8"?>
<!--
  Files SONORA may hand to another app. Only the downloaded update APK is shareable:
  the provider is scoped to the dedicated cache/updates directory, so track downloads and
  other cached files are never exposed by accident.
-->
<paths>
    <cache-path
        name="ota_apk"
        path="updates/" />
</paths>
