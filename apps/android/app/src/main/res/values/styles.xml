<resources>
    <style name="Theme.Sonora" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#08090D</item>
        <item name="android:navigationBarColor">#08090D</item>
        <item name="android:windowBackground">#08090D</item>
        <item name="android:colorAccent">#B8F36B</item>
    </style>
    <style name="Theme.Sonora.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#08090D</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_sonora_splash</item>
        <item name="windowSplashScreenAnimationDuration">850</item>
        <item name="postSplashScreenTheme">@style/Theme.Sonora</item>
    </style>
</resources>
