# Optional rights-holder catalog. The JSON file is managed by the API operator.
SONORA_LICENSED_CATALOG_FILE=
SONORA_LICENSED_AUDIO_ORIGIN=
SONORA_LICENSED_API_ORIGIN=

# Optional AI provider. Never expose this value to the browser.
OPENAI_API_KEY=
