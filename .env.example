# API
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Supabase Auth / public API configuration
SUPABASE_URL=https://qmnpszgbbuzfymezlcpb.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Jamendo developer client ID (server-side only). Obtain from https://developer.jamendo.com/
JAMENDO_CLIENT_ID=
JAMENDO_USE_MODE=
JAMENDO_COMMERCIAL_APPROVED=false

# Optional Spotify metadata lookup. Set the actual supported deployment market (ISO alpha-2).
