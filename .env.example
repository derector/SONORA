# API
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Supabase Auth / public API configuration
SUPABASE_URL=https://qmnpszgbbuzfymezlcpb.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Jamendo developer client ID (server-side only). Obtain from https://developer.jamendo.com/
JAMENDO_CLIENT_ID=
JAMENDO_USE_MODE=
JAMENDO_COMMERCIAL_APPROVED=false

# Optional Spotify metadata lookup. Set the actual supported deployment market (ISO alpha-2).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_CATALOG_MARKET=

# Optional rights-holder catalog. The JSON file is managed by the API operator.
SONORA_LICENSED_CATALOG_FILE=
SONORA_LICENSED_AUDIO_ORIGIN=
SONORA_LICENSED_API_ORIGIN=

# Optional AI provider. Never expose this value to the browser.
OPENAI_API_KEY=

# Optional. Server-only Azure Speech resource for the assistant's Russian voice.
SONORA_AZURE_SPEECH_REGION=
SONORA_AZURE_SPEECH_KEY=
# Optional comma-separated SONORA account UUIDs. Leave empty for all signed-in accounts.
SONORA_AZURE_SPEECH_USER_IDS=

# Optional server-owned JSON manifest with explicitly licensed synced lyrics.
SONORA_LICENSED_LYRICS_FILE=

# Optional byte-range proxy for the operator-owned licensed audio origin.
SONORA_LICENSED_PROXY_AUDIO=false
